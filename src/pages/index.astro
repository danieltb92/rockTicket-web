---
import Layout from '@layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Hero from '@components/sections/Hero.astro';
import SectionVideo from '@components/sections/SectionVideo.astro';
import SectionSliderWords from '@components/sections/SectionSliderWords.astro';
import SectionFeatures from '@components/sections/SectionFeatures.astro';
import SectionCTA from '@components/sections/SectionCTA.astro';
import SectionCarousel from '@components/sections/SectionCarousel.astro';
import Footer from '@components/layout/Footer.astro';
---

<Layout title="RockTicket — Entradas para conciertos de rock">
  <Header />
  <main id="contenido" class="w-full overflow-x-hidden">
    <Hero />
    <SectionSliderWords />
    <SectionVideo />
    <SectionFeatures />
    <SectionCTA />
    <SectionCarousel />
  </main>
  <Footer />
</Layout>
