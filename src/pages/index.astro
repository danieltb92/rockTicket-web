---
import Layout from '@layouts/Layout.astro';
import Header from '@components/layout/Header.astro';
import Hero from '@components/sections/Hero.astro';
import SectionVideo from '@components/sections/SectionVideo.astro';
import SectionSliderWords from '@components/sections/SectionSliderWords.astro';
import SectionFeatures from '@components/sections/SectionFeatures.astro';
import SectionCTA from '@components/sections/SectionCTA.astro';
import SectionCarousel from '@components/sections/SectionCarousel.astro';
import Footer from '@components/layout/Footer.astro';
---

<Layout title="RockTicket.">
	<main>
		<Header />
		<Hero />
		<SectionSliderWords />
		<SectionVideo />
		<SectionFeatures />
		<SectionCTA />
		<SectionCarousel />
		<Footer />
	</main>
</Layout>

<style>
@tailwind base;
@tailwind components;
@tailwind utilities;

	@layer base {
		h1, h2, h3 {
			@apply font-geist
		}
	}

	main {
		margin: 0 auto;
		padding: 0rem;
		width: 1920px;
		max-width: calc(100%);
		color: white;
		font-size: 20px;
		line-height: 1.6;
	}
	h1 {
		font-size: 4rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		margin-bottom: 1em;
	}
	h1,h2,h3{
		font-family:Geist, Verdana, Geneva, Tahoma, sans-serif;
	}
</style>
