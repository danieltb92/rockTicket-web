---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Compra entradas para conciertos y festivales de rock. Descubre eventos, artistas y experiencias en vivo con RockTicket.',
  image = '/rockTicket-web/logo.svg',
} = Astro.props;

import favicon from '@assets/favicon.svg';
import '@styles/global.css';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const siteName = 'RockTicket';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="rock, conciertos, festivales, entradas, música, rockTicket, eventos, bandas" />
    <meta name="author" content="RockTicket" />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:site" content="@rockticket" />

    <meta name="generator" content={Astro.generator} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": canonicalURL.origin + '/rockTicket-web',
      "description": description,
      "inLanguage": "es-CO",
      "publisher": {
        "@type": "Organization",
        "name": siteName,
        "logo": {
          "@type": "ImageObject",
          "url": canonicalURL.origin + '/rockTicket-web/logo.svg'
        }
      }
    })}></script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-black"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
