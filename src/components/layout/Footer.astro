---
const year = new Date().getFullYear();
---

<footer class="relative font-geist text-white">
  <div class="glow-line mx-auto h-px w-full" aria-hidden="true"></div>

  <div class="section-container pb-12 pt-20 md:pt-28">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-[1.5fr_1fr] md:gap-16">
      <div>
        <h2 class="mb-4 text-4xl">RockTicket</h2>
        <p class="max-w-md text-sm leading-relaxed text-white/50">
          Tu plataforma definitiva para disfrutar de conciertos, festivales y todos los
          eventos del mundo del rock. Compra entradas, descubre artistas y sigue de cerca
          los mejores shows en tu ciudad.
        </p>
        <div class="mt-6 flex gap-4">
          <a href="#" class="text-white/40 transition-colors hover:text-accent" aria-label="Facebook">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10 20v-6h2.3l.7-3H10V8.5c0-.9.2-1.5 1.5-1.5H13V4.2C12.7 4.1 11.6 4 10.5 4c-2.2 0-3.8 1.3-3.8 3.9V11H5v3h1.7v6H10z" />
            </svg>
          </a>
          <a href="#" class="text-white/40 transition-colors hover:text-accent" aria-label="Instagram">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7.75 2A5.75 5.75 0 002 7.75v8.5A5.75 5.75 0 007.75 22h8.5A5.75 5.75 0 0022 16.25v-8.5A5.75 5.75 0 0016.25 2h-8.5zm8.5 1.5a4.25 4.25 0 014.25 4.25v8.5a4.25 4.25 0 01-4.25 4.25h-8.5a4.25 4.25 0 01-4.25-4.25v-8.5a4.25 4.25 0 014.25-4.25h8.5zm-4.25 3a3.5 3.5 0 100 7 3.5 3.5 0 000-7zm5.5-.25a.75.75 0 110 1.5.75.75 0 010-1.5z" />
            </svg>
          </a>
          <a href="#" class="text-white/40 transition-colors hover:text-accent" aria-label="LinkedIn">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0H5C2.239 0 0 2.239 0 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5V5c0-2.761-2.239-5-5-5zM9.335 18.642H6.826v-8.42h2.509v8.42zm-1.253-9.597c-.8 0-1.446-.65-1.446-1.45 0-.801.646-1.451 1.446-1.451.8 0 1.447.65 1.447 1.451 0 .801-.647 1.45-1.447 1.45zm10.554 9.597h-2.508v-4.581c0-1.094-.022-2.5-1.521-2.5-1.523 0-1.756 1.19-1.756 2.421v4.66H9.843v-8.42h2.411v1.152h.034c.337-.64 1.16-1.314 2.386-1.314 2.55 0 3.02 1.676 3.02 3.854v4.728z" />
            </svg>
          </a>
          <a href="#" class="text-white/40 transition-colors hover:text-accent" aria-label="X (Twitter)">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 4.557a9.837 9.837 0 0 1-2.828.775 4.932 4.932 0 0 0 2.165-2.724 9.865 9.865 0 0 1-3.127 1.195 4.916 4.916 0 0 0-8.374 4.482A13.944 13.944 0 0 1 1.671 3.15 4.917 4.917 0 0 0 3.17 9.723a4.903 4.903 0 0 1-2.224-.616v.06a4.918 4.918 0 0 0 3.946 4.827 4.996 4.996 0 0 1-2.218.084 4.928 4.928 0 0 0 4.6 3.417 9.874 9.874 0 0 1-6.104 2.104c-.396 0-.788-.023-1.175-.068A13.933 13.933 0 0 0 7.548 21c9.054 0 14.002-7.503 14.002-14.002 0-.213-.005-.425-.014-.636A9.936 9.936 0 0 0 24 4.557z" />
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <h3 class="mb-4 text-xl tracking-[0.08em] text-accent/70">Explora</h3>
          <ul class="space-y-2.5 text-sm text-white/50">
            <li><a href="#" class="transition-colors hover:text-white">Eventos populares</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Conciertos en tu ciudad</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Festivales de rock</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Descubre nuevos artistas</a></li>
          </ul>
        </div>
        <div>
          <h3 class="mb-4 text-xl tracking-[0.08em] text-accent/70">Innovación</h3>
          <ul class="space-y-2.5 text-sm text-white/50">
            <li><a href="#" class="transition-colors hover:text-white">Pases VIP</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Mapa de escenarios</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Experiencias exclusivas</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Entradas seguras</a></li>
          </ul>
        </div>
        <div>
          <h3 class="mb-4 text-xl tracking-[0.08em] text-accent/70">Acerca de</h3>
          <ul class="space-y-2.5 text-sm text-white/50">
            <li><a href="#" class="transition-colors hover:text-white">Quiénes somos</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Nuestro equipo</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Soporte al cliente</a></li>
            <li><a href="#" class="transition-colors hover:text-white">Términos y condiciones</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="glow-line mx-auto h-px w-full" aria-hidden="true"></div>

    <p class="mt-8 text-center text-xs text-white/30 md:mt-10">
      © {year} RockTicket. Todos los derechos reservados.
    </p>
  </div>
</footer>
