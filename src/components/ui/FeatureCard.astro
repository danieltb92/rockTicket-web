---
export interface CardProps {
  title: string;
  paragraph: string;
  imageSrc: string;
  imageWidth?: number;
  imageHeight?: number;
  bgColor: string;
  direction: 'left' | 'right' | 'top';
  index?: number;
}

const {
  title,
  paragraph,
  imageSrc,
  imageWidth,
  imageHeight,
  bgColor,
  direction = 'right',
  index = 0,
} = Astro.props;
---

<article
  class:list={[
    'glass-card group flex w-full flex-col items-center gap-8 p-6 md:max-w-5xl md:flex-row md:gap-12 md:p-10',
    direction === 'right' && 'md:flex-row-reverse',
    direction === 'left' && 'md:flex-row',
  ]}
>
  <div class="flex flex-1 flex-col items-center gap-4 text-center md:items-start md:text-left">
    <span class="font-geist text-xs font-semibold uppercase tracking-[0.2em] text-accent/70">
      0{index + 1}
    </span>
    <h3 class="max-w-md font-squada text-3xl font-bold leading-tight md:text-4xl">{title}</h3>
    <p class="max-w-sm font-geist text-base leading-relaxed text-white/60">{paragraph}</p>
  </div>

  <div class="relative flex h-[380px] w-full max-w-[480px] flex-1 items-center justify-center overflow-hidden rounded-2xl sm:h-[440px] md:h-[480px]">
    <div
      class="absolute inset-0 rounded-2xl opacity-80 transition-opacity duration-500 group-hover:opacity-100"
      style={`background: ${bgColor}`}
      aria-hidden="true"
    ></div>
    <img
      src={imageSrc}
      alt={title}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
      class="relative z-10 max-h-[85%] w-auto max-w-[80%] object-contain drop-shadow-2xl transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
</article>
