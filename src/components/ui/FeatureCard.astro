---
export interface CardProps {
  title: string;
  paragraph: string;
  imageSrc: string;
  bgColor: string;
  direction: 'left' | 'right' | 'top';
}

// Proporcionar valores predeterminados si no se pasan props
const title = Astro.props.title || 'Explora Eventos';
const paragraph = Astro.props.paragraph || 'Descubre eventos de Rock en tu ciudad y encuentra los mejores festivales y conciertos personalizados según tus gustos.';
const imageSrc = Astro.props.imageSrc || '../public/images/features-img/Home-Sony Xperia 1 II.svg';
const bgColor = Astro.props.bgColor || 'linear-gradient(180deg, #93C9C7 0%, #486362 100%)';
const direction = Astro.props.direction || 'right';
---

<article
  class={`flex ${
    direction === 'right'
      ? 'md:flex-row-reverse'
      : direction === 'left'
      ? 'md:flex-row'
      : 'flex-col'
  } flex-col w-full max-w-6xl mx-auto items-center justify-between py-12 md:py-16 px-4 sm:px-6 md:px-8 gap-10 md:gap-16 lg:gap-24 overflow-visible`}
>
  <div class="flex flex-col justify-center items-center md:items-start text-center md:text-left w-full md:w-1/2 max-w-[480px] gap-4 md:gap-6">
    <h3 class="font-sourceSans font-bold text-4xl sm:text-5xl leading-tight text-white tracking-tight">
      {title}
    </h3>
    <p class="font-normal text-base md:text-lg leading-relaxed text-neutral-300 max-w-[420px]">
      {paragraph}
    </p>
  </div>

  <div class="relative w-full md:w-1/2 max-w-[480px] md:max-w-[540px] aspect-[4/5] sm:aspect-[4/4.5] md:aspect-[4/5] flex items-end justify-center select-none group overflow-visible">
    <!-- Card Background with gradient -->
    <div
      class="absolute inset-x-4 top-[12%] bottom-4 rounded-[32px] md:rounded-[40px] shadow-2xl transition-transform duration-500 group-hover:scale-[1.02]"
      style={`background: ${bgColor}`}
    ></div>
    <!-- Phone Image overlapping the background -->
    <img
      src={imageSrc}
      alt={title}
      class="relative z-10 w-[70%] sm:w-[65%] max-h-[105%] object-contain transition-transform duration-500 ease-out group-hover:-translate-y-3"
    />
  </div>
</article>

