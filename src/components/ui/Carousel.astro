---
import { Image } from 'astro:assets';
import img1 from '@assets/images/carousel/image1.png';
import img2 from '@assets/images/carousel/image2.png';
import img3 from '@assets/images/carousel/image3.png';
import img4 from '@assets/images/carousel/image4.png';
import img5 from '@assets/images/carousel/image5.png';

const images = [
  { src: img1, alt: 'Público en un concierto de rock' },
  { src: img2, alt: 'Artista en el escenario' },
  { src: img3, alt: 'Multitud en un festival' },
  { src: img4, alt: 'Concierto en vivo' },
  { src: img5, alt: 'Fans disfrutando un show' },
];

const track = [...images, ...images];
---

<div class="relative h-[400px] w-full overflow-hidden max-md:h-[300px]" role="region" aria-label="Galería de conciertos">
  <div class="flex h-full w-max animate-slide">
    {
      track.map((image, index) => (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[480, 720, 960]}
          sizes="(max-width: 768px) 80vw, 480px"
          loading="lazy"
          decoding="async"
          class="h-full w-auto shrink-0 object-cover"
          format="webp"
          quality={80}
        />
      ))
    }
  </div>
</div>
