---
import FeatureCardAnimated from '../islands/FeatureCardAnimated';
import imgFeature1 from '@assets/images/features-img/Home-SonyXperia1II.svg';
import imgFeature2 from '@assets/images/features-img/Mockup-Tickets-SonyXperia1II.svg';
import imgFeature3 from '@assets/images/features-img/Mockup-Notifications-SonyXperia1II.svg';

const features = [
  {
    title: "Explora Eventos Cercanos",
    paragraph: "Descubre eventos de Rock en tu ciudad y encuentra los mejores festivales y conciertos personalizados según tus gustos.",
    imageSrc: imgFeature1.src,
    bgColor: "linear-gradient(135deg, #93C9C7 0%, #3d6b69 100%)",
    direction: "right" as const,
  },
  {
    title: "Compra de Tickets en Un Clic",
    paragraph: "Consigue tus entradas rápidamente con nuestro sistema de compra sencillo y seguro, sin largas esperas.",
    imageSrc: imgFeature2.src,
    bgColor: "linear-gradient(135deg, #57578A 0%, #1e1e3a 100%)",
    direction: "left" as const,
  },
  {
    title: "Notificaciones Personalizadas",
    paragraph: "No te pierdas ninguna oportunidad. Recibe alertas de nuevos eventos, preventas y promociones especiales.",
    imageSrc: imgFeature3.src,
    bgColor: "linear-gradient(135deg, #666 0%, #333 100%)",
    direction: "right" as const,
  },
];
---

<section
  id="funciones"
  class="section-container flex flex-col items-center py-20 md:py-32"
  aria-labelledby="features-heading"
>
  <header class="mb-16 max-w-3xl text-center md:mb-24">
    <span class="mb-4 inline-block font-geist text-xs font-semibold uppercase tracking-[0.25em] text-accent/70">
      Funciones
    </span>
    <h2 id="features-heading" class="font-squada text-4xl font-bold md:text-5xl lg:text-6xl">
      Todo lo que Necesitas <br class="hidden sm:block" />
      para Disfrutar del Rock
    </h2>
  </header>

  <div class="flex w-full flex-col items-center gap-12 md:gap-20 lg:gap-24">
    {features.map((feature, index) => (
      <FeatureCardAnimated
        title={feature.title}
        paragraph={feature.paragraph}
        imageSrc={feature.imageSrc}
        bgColor={feature.bgColor}
        direction={feature.direction}
        index={index}
        client:load
      />
    ))}
  </div>
</section>
