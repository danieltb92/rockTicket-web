---
const palabras = [
  'Rock',
  'Música',
  'Conciertos',
  'Festivales',
  'Bandas',
  'Escenario',
  'Guitarras',
  'Baterías',
];

const wordsUpper = palabras.map((palabra) => palabra.toUpperCase());
const track = [...wordsUpper, ...wordsUpper, ...wordsUpper];
---

<div
  class="relative h-16 w-full overflow-hidden border-y border-surface-border bg-surface max-md:h-14"
  aria-hidden="true"
>
  <div class="absolute inset-y-0 left-0 w-20 bg-gradient-to-r from-black to-transparent z-10" aria-hidden="true"></div>
  <div class="absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-black to-transparent z-10" aria-hidden="true"></div>
  <div class="flex h-full w-max animate-marquee items-center whitespace-nowrap">
    {
      track.map((word, i) => (
        <span class="flex shrink-0 items-center gap-12">
          <span class="text-2xl font-semibold tracking-wider text-white/20 max-md:text-xl">{word}</span>
          {i < track.length - 1 && (
            <span class="h-1 w-1 rounded-full aria-hidden="true" />
          )}
        </span>
      ))
    }
  </div>
</div>
