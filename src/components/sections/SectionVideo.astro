---
import SectionVideoAnimated from '../islands/SectionVideoAnimated';
import videoSrc from '@assets/VideoRock-Hd 1920 1080 30Fps.mp4';
---

<SectionVideoAnimated videoSrc={videoSrc} poster="/rockTicket-web/images/poster-video.jpg" client:load />

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('[data-lazy-video]');

  if (videos.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => undefined);
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '120px' }
    );

    videos.forEach((video) => observer.observe(video));
  } else {
    videos.forEach((video) => video.play().catch(() => undefined));
  }
</script>
