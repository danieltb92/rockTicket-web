---
import HeroAnimated from '../islands/HeroAnimated';
import AppStore from "../icons/AppStore.astro";
import GooglePlay from "../icons/GooglePlay.astro";
import imgHero from "@assets/iPhone-15-Pro-Showcase-Screen-Scene-psd-MockupLLKLL 2.svg";
---

<HeroAnimated
  titleLine1="Dejate Contagiar"
  titleLine2="Por El"
  accentWord="Rock"
  subtitle="Descubre, compra y disfruta de tus concierto favoritos con RockTicket."
  client:load
>
  <img
    class="h-auto w-[110%] max-w-none object-cover object-center md:scale-[1.0] max-md:w-[120%] max-md:min-h-[600px] max-md:scale-[1.0] max-md:object-center"
    src={imgHero.src}
    alt="Aplicación RockTicket en un iPhone mostrando eventos de rock"
    width={imgHero.width}
    height={imgHero.height}
    fetchpriority="high"
    decoding="async"
  />
  <div
    class="relative bottom-14 md:bottom-28 z-20 flex md:flex-row justify-center items-center gap-0 sm:gap-6 max-md:pl-0 max-sm:justify-center sm:pl-[20%] md:pl-[40%] -mt-[10vh] max-sm:-mt-36"
  >
    <AppStore />
    <GooglePlay />
  </div>
</HeroAnimated>
