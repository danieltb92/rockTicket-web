---
import Carousel from "../ui/Carousel.astro";
---

<section class="py-16 md:py-24" aria-label="Momentos en conciertos">
  <header class="section-container mb-10 text-center md:mb-14">
    <span
      class="mb-3 inline-block text-xs font-semibold uppercase tracking-[0.25em] text-accent/70"
    >
      Galería
    </span>
    <h2 class="text-3xl font-bold md:text-7xl">
      Momentos que Definen <br class="hidden sm:block" /> la Experiencia
    </h2>
  </header>
  <Carousel />
</section>
