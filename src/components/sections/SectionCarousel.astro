---
import SectionCarouselAnimated from '../islands/SectionCarouselAnimated';
import img1 from '@assets/images/carousel/image1.png';
import img2 from '@assets/images/carousel/image2.png';
import img3 from '@assets/images/carousel/image3.png';
import img4 from '@assets/images/carousel/image4.png';
import img5 from '@assets/images/carousel/image5.png';

const images = [
  { src: img1.src, alt: 'Público en un concierto de rock' },
  { src: img2.src, alt: 'Artista en el escenario' },
  { src: img3.src, alt: 'Multitud en un festival' },
  { src: img4.src, alt: 'Concierto en vivo' },
  { src: img5.src, alt: 'Fans disfrutando un show' },
];
---

<SectionCarouselAnimated images={images} client:load />
